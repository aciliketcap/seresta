// copy this as .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Parser Dev",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/parsing/parsers",
                    "remoteRoot": "/parsers"
                },
                {
                    "localRoot": "${workspaceFolder}/parsing/serespar/src/serespar",
                    "remoteRoot": "serespar"
                }
            ]
        },
        {
            "name": "Test Dev",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/parsing/test/test_parser",
                    "remoteRoot": "/test_parser"
                },
                {
                    "localRoot": "${workspaceFolder}/parsing/serespar/src/serespar",
                    "remoteRoot": "serespar"
                }
            ]
        }
    ]
}