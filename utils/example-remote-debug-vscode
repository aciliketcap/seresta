// copy this as .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/parsing/app/",
                    "remoteRoot": "/app/"
                },
                {
                    "localRoot": "${workspaceFolder}/serespar",
                    "remoteRoot": "serespar"
                }
            ]
        }
    ]
}