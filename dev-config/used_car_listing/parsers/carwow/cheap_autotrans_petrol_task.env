# The postcode is deliberately not here: it says where the person running the
# task lives, so it stays out of the repo. Set it in the shell that starts
# compose, which passes it through:
#
#   SERESPAR_ORIGIN_QUERY__POSTCODE="..." podman compose up
#
# Without it the task stops with a ConfigurationException instead of searching
# somewhere else.
SERESPAR_ORIGIN_QUERY__PRICE_MIN="10000"
SERESPAR_ORIGIN_QUERY__PRICE_MAX="18000"
SERESPAR_ORIGIN_QUERY__TRANSMISSION="Automatic"
