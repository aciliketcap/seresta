# Read by the postgres container itself: it creates this database on first run.
POSTGRES_DB=used_cars

# Read by the parser, as the `ProjectConfig` layer. The project config knows
# the database name and the defaults for port and sslmode
# (SERESPAR_DB_NAME / SERESPAR_DB_PORT / SERESPAR_DB_SSLMODE override them),
# so only the host has to be stated here.
SERESPAR_DB_HOST=postgres
